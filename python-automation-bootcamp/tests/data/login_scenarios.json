{
  "suite": "Authentication API",
  "description": "Login scenarios",
  "scenarios": [
    {
      "id":"AUTH-001",
      "name":"Valid login",
      "method":"POST",
      "endpoint":"/login",
      "payload": {
        "username": "user_1",
        "password": "password_1"
      },
      "expected_status": 200
    },
    {
      "id":"AUTH-002",
      "name":"Invalid login",
      "method":"POST",
      "endpoint":"/login",
      "payload": {
        "username": "user_2",
        "password": "password_2"
      },
      "expected_status": 401
    },
    {
      "id":"AUTH-003",
      "name":"Unknown user",
      "method":"POST",
      "endpoint":"/login",
      "payload": {
        "username": "user_3",
        "password": "password_3"
      },
      "expected_status": 404
    }
  ]
}